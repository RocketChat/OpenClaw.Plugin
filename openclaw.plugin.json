{
  "id": "rocketchat",
  "name": "Rocket.Chat",
  "description": "Rocket.Chat channel plugin with DDP/websocket outbound/inbound",
  "version": "1.1.9",
  "kind": "channel",
  "channels": [
    "rocketchat"
  ],
  "channelConfigs": {
    "rocketchat": {
      "schema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "accounts": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "minLength": 1
            },
            "additionalProperties": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "serverUrl": {
                  "type": "string",
                  "minLength": 1
                },
                "auth": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "mode": {
                          "type": "string",
                          "const": "token"
                        },
                        "userId": {
                          "type": "string",
                          "minLength": 1
                        },
                        "accessToken": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": [
                        "mode",
                        "userId",
                        "accessToken"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "mode": {
                          "type": "string",
                          "const": "password"
                        },
                        "username": {
                          "type": "string",
                          "minLength": 1
                        },
                        "password": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": [
                        "mode",
                        "username",
                        "password"
                      ],
                      "additionalProperties": false
                    }
                  ]
                },
                "transport": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "mode": {
                          "type": "string",
                          "const": "websocket"
                        },
                        "reconnectDelayMs": {
                          "default": 2000,
                          "type": "integer",
                          "exclusiveMinimum": 0,
                          "maximum": 9007199254740991
                        }
                      },
                      "required": [
                        "mode"
                      ],
                      "additionalProperties": false
                    }
                  ]
                },
                "mentionNames": {
                  "default": [],
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "agent": {
                  "type": "string",
                  "minLength": 1
                },
                "owner": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "enabled",
                "serverUrl",
                "auth",
                "transport",
                "mentionNames"
              ],
              "additionalProperties": false
            }
          },
          "limits": {
            "type": "object",
            "properties": {
              "maxAccounts": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 50
              },
              "maxBotsPerServer": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 25
              },
              "botCreationCooldownMs": {
                "type": "integer",
                "minimum": 5000,
                "maximum": 9007199254740991
              },
              "maxReconnects": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 100
              },
              "maxConcurrentTurns": {
                "type": "integer",
                "minimum": 1,
                "maximum": 32
              }
            },
            "additionalProperties": false
          }
        },
        "required": [
          "accounts"
        ],
        "additionalProperties": false
      },
      "uiHints": {
        "accounts.*.serverUrl": {
          "label": "Server URL",
          "placeholder": "https://chat.example.com"
        }
      }
    }
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": true
  }
}
