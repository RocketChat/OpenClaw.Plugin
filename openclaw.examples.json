{
  "meta": {
    "lastTouchedVersion": "2026.7.1-2"
  },
  "channels": {
    "rocketchat": {
      "accounts": {
        "botname": {
          "enabled": true,
          "serverUrl": "http://localhost:3000",
          "auth": {
            "mode": "token",
            "userId": "YOUR_ROCKETCHAT_BOT_USER_ID",
            "accessToken": "YOUR_ROCKETCHAT_BOT_ACCESS_TOKEN"
          },
          "transport": {
            "mode": "websocket"
          },
          "mentionNames": ["botname"],
          "owner": "admin-user"
        }
      }
    }
  },
  "bindings": [
    {
      "agentId": "main",
      "match": {
        "channel": "rocketchat",
        "accountId": "botname"
      }
    }
  ],
  "plugins": {
    "allow": ["rocketchat"],
    "entries": {
      "rocketchat": {
        "enabled": true
      }
    }
  }
}
