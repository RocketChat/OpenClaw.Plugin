{
  "channels": {
    "rocketchat": {
      "accounts": {
        "main": {
          "enabled": true,
          "serverUrl": "https://chat.example.com",
          "auth": {
            "mode": "token",
            "userId": "<bot-user-id>",
            "accessToken": "<bot-personal-access-token>"
          },
          "transport": { "mode": "websocket" },
          "mentionNames": ["rocketbot"],
          "owner": "alice"
        }
      }
    }
  },
  "bindings": [
    { "match": { "channel": "rocketchat", "accountId": "main" }, "agentId": "rc-main" }
  ],
  "models": {
    "providers": {
      "ollama": {
        "baseUrl": "http://127.0.0.1:11434",
        "apiKey": "ollama",
        "api": "ollama",
        "models": [
          {
            "id": "llama3.2:3b",
            "name": "Llama 3.2 3B",
            "contextWindow": 16000,
            "maxTokens": 4096
          }
        ]
      }
    }
  },
  "agents": {
    "defaults": { "model": "ollama/llama3.2:3b" }
  }
}
