{
  "name": "@dodaa08/openclaw-plugin-test",
  "version": "1.2.1",
  "description": "A fully unified plugin for integrating Rocket.Chat with OpenClaw. This plugin eliminates the need for an external bridging server, providing a direct, single-place architecture for inbounds, outbounds, session management, and CLI configuration.",
  "main": "dist/index.js",
  "peerDependencies": {
    "openclaw": ">=2026.7.1-2"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.7.1-2"
    },
    "build": {
      "openclawVersion": "2026.7.1-2",
      "pluginSdkVersion": "2026.7.1-2"
    }
  },
  "type": "module",
  "scripts": {
    "build": "rm -rf dist && pnpm run manifest && tsc && pnpm run bundle",
    "bundle": "esbuild src/client/ddp.ts --bundle --format=esm --platform=node --outfile=dist/client/ddp.js --sourcemap",
    "manifest": "tsx scripts/gen-manifest.mts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "start": "node dist/index.js",
    "setup": "openclaw rocket-chat setup",
    "test": "echo '✅ No tests yet'"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RocketChat/OpenClaw.Plugin.git"
  },
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "rocketchat",
    "channel",
    "chat"
  ],
  "author": "Rocket.Chat",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/RocketChat/OpenClaw.Plugin/issues"
  },
  "homepage": "https://github.com/RocketChat/OpenClaw.Plugin#readme",
  "files": [
    "dist",
    "openclaw.plugin.json",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@clack/core": "1.4.3",
    "@types/node": "^25.9.1",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.1",
    "openclaw": "^2026.7.1-2",
    "prettier": "^3.9.6",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@rocket.chat/ddp-client": "^1.1.1",
    "@clack/prompts": "^1.7.0",
    "commander": "^15.0.0",
    "json5": "^2.2.3",
    "picocolors": "^1.1.1",
    "zod": "^4.4.3"
  },
  "packageManager": "pnpm@10.33.0"
}
