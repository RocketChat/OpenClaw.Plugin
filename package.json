{
  "name": "@rocketchat/openclaw-plugin",
  "version": "1.0.0",
  "description": "A fully unified plugin for integrating Rocket.Chat with OpenClaw. This plugin eliminates the need for an external bridging server, providing a direct, single-place architecture for inbounds, outbounds, session management, and CLI configuration.",
  "main": "dist/index.js",
  "openclaw": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "type": "module",
  "bin": {
    "openclaw-rocketchat": "dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "setup": "node --import tsx src/cli/index.ts setup",
    "status": "node --import tsx src/cli/index.ts status",
    "add-bot": "node --import tsx src/cli/index.ts add-bot",
    "add-group": "node --import tsx src/cli/index.ts add-group",
    "remove-group": "node --import tsx src/cli/index.ts remove-group",
    "groups": "node --import tsx src/cli/index.ts groups",
    "bots": "node --import tsx src/cli/index.ts bots",
    "bind-agent": "node --import tsx src/cli/index.ts bind-agent",
    "remove-bot": "node --import tsx src/cli/index.ts remove-bot",
    "allow-user": "node --import tsx src/cli/index.ts allow-user",
    "remove-user": "node --import tsx src/cli/index.ts remove-user",
    "users": "node --import tsx src/cli/index.ts users",
    "cli": "node --import tsx src/cli/index.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RocketChat/OpenClaw.Plugin.git"
  },
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "rocketchat",
    "channel",
    "chat"
  ],
  "author": "Rocket.Chat",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/RocketChat/OpenClaw.Plugin/issues"
  },
  "homepage": "https://github.com/RocketChat/OpenClaw.Plugin#readme",
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/ws": "^8.18.1",
    "openclaw": "^2026.7.1-2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "@rocket.chat/ddp-client": "^1.1.1",
    "commander": "^15.0.0",
    "picocolors": "^1.1.1",
    "zod": "^4.4.3"
  }
}
